#include <iostream>
#include <fstream>
#include <cstring>
using namespace std;

// 📘 Book Class
class Book {
public:
    int bookID;
    char title[50];
    char author[50];
    bool isIssued;

    void addBook() {
        cout << "Enter Book ID: ";
        cin >> bookID;
        cin.ignore();

        cout << "Enter Title: ";
        cin.getline(title, 50);

        cout << "Enter Author: ";
        cin.getline(author, 50);

        isIssued = false;
    }

    void displayBook() {
        cout << "\nBook ID: " << bookID;
        cout << "\nTitle: " << title;
        cout << "\nAuthor: " << author;
        cout << "\nStatus: " << (isIssued ? "Issued" : "Available") << endl;
    }
};

// 👤 Member Class
class Member {
public:
    int memberID;
    char name[50];

    void addMember() {
        cout << "Enter Member ID: ";
        cin >> memberID;
        cin.ignore();

        cout << "Enter Member Name: ";
        cin.getline(name, 50);
    }

    void displayMember() {
        cout << "\nMember ID: " << memberID;
        cout << "\nName: " << name << endl;
    }
};

// ➕ Add Book
void addBook() {
    Book b;
    ofstream file("books.dat", ios::binary | ios::app);

    b.addBook();
    file.write((char*)&b, sizeof(b));

    file.close();
    cout << "Book added successfully!\n";
}

// 📖 Display Books
void displayBooks() {
    Book b;
    ifstream file("books.dat", ios::binary);

    while (file.read((char*)&b, sizeof(b))) {
        b.displayBook();
    }

    file.close();
}

// 🔍 Search Book
void searchBook() {
    Book b;
    char keyword[50];
    bool found = false;

    cin.ignore();
    cout << "Enter Title or Author to search: ";
    cin.getline(keyword, 50);

    ifstream file("books.dat", ios::binary);

    while (file.read((char*)&b, sizeof(b))) {
        if (strstr(b.title, keyword) || strstr(b.author, keyword)) {
            b.displayBook();
            found = true;
        }
    }

    file.close();

    if (!found)
        cout << "No matching books found.\n";
}

// 📤 Issue Book
void issueBook() {
    int id;
    Book b;
    bool found = false;

    cout << "Enter Book ID to issue: ";
    cin >> id;

    fstream file("books.dat", ios::binary | ios::in | ios::out);

    while (file.read((char*)&b, sizeof(b))) {
        if (b.bookID == id) {
            if (b.isIssued) {
                cout << "Book already issued!\n";
            } else {
                b.isIssued = true;
                int pos = file.tellg() - sizeof(b);
                file.seekp(pos);
                file.write((char*)&b, sizeof(b));
                cout << "Book issued successfully!\n";
            }
            found = true;
            break;
        }
    }

    file.close();

    if (!found)
        cout << "Book not found.\n";
}

// 📥 Return Book
void returnBook() {
    int id;
    Book b;
    bool found = false;

    cout << "Enter Book ID to return: ";
    cin >> id;

    fstream file("books.dat", ios::binary | ios::in | ios::out);

    while (file.read((char*)&b, sizeof(b))) {
        if (b.bookID == id) {
            if (!b.isIssued) {
                cout << "Book was not issued!\n";
            } else {
                b.isIssued = false;
                int pos = file.tellg() - sizeof(b);
                file.seekp(pos);
                file.write((char*)&b, sizeof(b));
                cout << "Book returned successfully!\n";
            }
            found = true;
            break;
        }
    }

    file.close();

    if (!found)
        cout << "Book not found.\n";
}

// ➕ Add Member
void addMember() {
    Member m;
    ofstream file("members.dat", ios::binary | ios::app);

    m.addMember();
    file.write((char*)&m, sizeof(m));

    file.close();
    cout << "Member added successfully!\n";
}

// 👀 Display Members
void displayMembers() {
    Member m;
    ifstream file("members.dat", ios::binary);

    while (file.read((char*)&m, sizeof(m))) {
        m.displayMember();
    }

    file.close();
}

// 🧭 Main Menu
int main() {
    int choice;

    do {
        cout << "\n===== LIBRARY MANAGEMENT SYSTEM =====\n";
        cout << "1. Add Book\n";
        cout << "2. Display Books\n";
        cout << "3. Search Book\n";
        cout << "4. Issue Book\n";
        cout << "5. Return Book\n";
        cout << "6. Add Member\n";
        cout << "7. Display Members\n";
        cout << "8. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: addBook(); break;
            case 2: displayBooks(); break;
            case 3: searchBook(); break;
            case 4: issueBook(); break;
            case 5: returnBook(); break;
            case 6: addMember(); break;
            case 7: displayMembers(); break;
            case 8: cout << "Exiting...\n"; break;
            default: cout << "Invalid choice!\n";
        }

    } while (choice != 8);

    return 0;
}
